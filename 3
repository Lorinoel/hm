class Animal:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    def speak(self):
        print("Тваринка видає звуки.")

    def info(self):
        print(f"Ім'я: {self.name}, Вік: {self.age}")

class Dog(Animal):
    def speak(self):
        print("Гав! Гав! Гав!")

class Cat(Animal):
    def speak(self):
        print("Мяяяу!")

dog1 = Dog("Бобік", 3)
cat1 = Cat("Мурка", 2)

dog1.info()
dog1.speak()

cat1.info()
cat1.speak()
